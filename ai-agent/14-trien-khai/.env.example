# Khóa quản trị cho /metrics, ít nhất 16 ký tự. BẮT BUỘC.
ADMIN_KEY=
# Cổng (mặc định 3300)
PORT=3300
# true thì tắt agent: mọi tin chuyển thẳng cho người (mặc định false)
AGENT_TAT=false
# Số tin tối đa của một cuộc trò chuyện trong một phút (mặc định 20)
GIOI_HAN_MOI_PHUT=20
# Độ dài tối đa của một tin (mặc định 1000)
MAX_DO_DAI_TIN=1000
# Giả lập độ trễ mô hình, ms (mặc định 0)
DO_TRE_MO_HINH_MS=0
