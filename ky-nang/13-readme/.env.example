# Sao chép file này thành .env rồi điền giá trị thật. File .env KHÔNG được commit (đã nằm trong .gitignore).
# Mỗi biến có một dòng mô tả. Biến không có giá trị mặc định thì bắt buộc phải điền.

# Cổng máy chủ lắng nghe, từ 1 đến 65535. Mặc định 3000.
PORT=3000

# development, test hoặc production. Mặc định development.
NODE_ENV=development

# Mức log: debug, info, warn hoặc error. Mặc định info.
LOG_LEVEL=info

# Có ghi log từng request không: true hoặc false. Mặc định false.
LOG_REQUESTS=false

# Đường dẫn file đơn hàng, tính từ thư mục gốc của dự án. Mặc định data/orders.json.
ORDERS_FILE=data/orders.json

# BẮT BUỘC. Khóa mà website của quán gửi kèm khi POST đơn mới (ít nhất 16 ký tự).
# Tạo một khóa ngẫu nhiên bằng: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
ORDER_API_KEY=
